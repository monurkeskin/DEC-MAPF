{
  "name": "dec-mapf-workspace",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --max-warnings=0",
    "preview": "vite preview",
    "test": "playwright test",
    "schema": "openapi-typescript ../docs/gui/openapi.json -o src/api/generated.ts",
    "typecheck": "tsc -b",
    "format:check": "prettier --check src tests *.ts *.json *.html",
    "prebuild": "node ../scripts/frontend_licenses.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "pixi.js": "8.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.83.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
